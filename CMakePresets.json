{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "desktop",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "VIRTOOLSDEV_BUILD_TESTS": "ON",
        "VIRTOOLSDEV_BUILD_UI_TESTS": "ON"
      }
    },
    {"name": "windows-x86", "inherits": "desktop", "generator": "Visual Studio 17 2022", "architecture": "Win32", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "windows-x64", "inherits": "desktop", "generator": "Visual Studio 17 2022", "architecture": "x64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "linux-x64", "inherits": "desktop", "generator": "Ninja", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
    {"name": "macos-x64", "inherits": "desktop", "generator": "Ninja", "cacheVariables": {"CMAKE_OSX_ARCHITECTURES": "x86_64"}, "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}},
    {"name": "macos-arm64", "inherits": "desktop", "generator": "Ninja", "cacheVariables": {"CMAKE_OSX_ARCHITECTURES": "arm64"}, "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}}
  ],
  "buildPresets": [
    {"name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release"},
    {"name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release"},
    {"name": "linux-x64", "configurePreset": "linux-x64"},
    {"name": "macos-x64", "configurePreset": "macos-x64"},
    {"name": "macos-arm64", "configurePreset": "macos-arm64"}
  ],
  "testPresets": [
    {"name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release", "output": {"outputOnFailure": true}, "execution": {"timeout": 180}},
    {"name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release", "output": {"outputOnFailure": true}, "execution": {"timeout": 180}},
    {"name": "linux-x64", "configurePreset": "linux-x64", "output": {"outputOnFailure": true}, "execution": {"timeout": 180}},
    {"name": "macos-x64", "configurePreset": "macos-x64", "output": {"outputOnFailure": true}, "execution": {"timeout": 180}},
    {"name": "macos-arm64", "configurePreset": "macos-arm64", "output": {"outputOnFailure": true}, "execution": {"timeout": 180}}
  ]
}
