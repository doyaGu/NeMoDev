# Build the SDK and the editor's runtime together. Do not add Ballanced's
# root project: its Player and game-asset staging belong to that application.
set(VIRTOOLS_SDK_PATH "" CACHE PATH "Ballanced source checkout (required)")
if(NOT VIRTOOLS_SDK_PATH)
    message(FATAL_ERROR "Set VIRTOOLS_SDK_PATH to the Ballanced source checkout.")
endif()
file(TO_CMAKE_PATH "${VIRTOOLS_SDK_PATH}" VIRTOOLS_SDK_PATH)
foreach(_component VxMath CK2 RenderEngine Managers Plugins BuildingBlocks)
    if(NOT EXISTS "${VIRTOOLS_SDK_PATH}/Source/${_component}/CMakeLists.txt")
        message(FATAL_ERROR "VIRTOOLS_SDK_PATH must name a complete Ballanced checkout: missing Source/${_component}")
    endif()
endforeach()
find_package(SDL3 3.4.8 CONFIG REQUIRED)
if(NOT TARGET SDL3::SDL3-shared)
    message(FATAL_ERROR "The Ballanced runtime requires shared SDL3")
endif()
install(IMPORTED_RUNTIME_ARTIFACTS SDL3::SDL3-shared
    RUNTIME DESTINATION Bin COMPONENT Runtime
    LIBRARY DESTINATION Bin COMPONENT Runtime)
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
foreach(_component VXMATH CK2 CKRE CKBB CKPLUGINS SDLINPUT SDLSOUND CKPARAMOP)
    set(${_component}_BUILD_SHARED ON)
    set(${_component}_BUILD_STATIC OFF)
    set(${_component}_BUILD_TESTS OFF)
    set(${_component}_INSTALL ON)
endforeach()
set(VXMATH_BUILD_PERF OFF)
set(CKRE_BUILD_TOOLS OFF)
set(CKRE_BUILD_SDL_GPU_RASTERIZER ON)
set(CKBB_BUILD_ALL_MODULES ON)
set(CKMANAGERS_BUILD_ALL ON)
set(BUILD_TESTING OFF)
foreach(_component VxMath CK2 RenderEngine Managers Plugins BuildingBlocks)
    add_subdirectory("${VIRTOOLS_SDK_PATH}/Source/${_component}" "Ballanced/${_component}")
endforeach()
set(VIRTOOLS_SDK_INCLUDE_DIR "${VIRTOOLS_SDK_PATH}/Source/CK2/include")
set(VIRTOOLSDEV_BALLANCED ON)
set(VIRTOOLS_RUNTIME_PATH "${PROJECT_BINARY_DIR}/runtime/Bin")
file(STRINGS "${VIRTOOLS_SDK_INCLUDE_DIR}/CKDefines.h" _version_definitions
    REGEX "^#define (CKVERSION|DEVVERSION) 0x[0-9A-Fa-f]+")
foreach(_definition IN LISTS _version_definitions)
    string(REGEX REPLACE "^#define ([A-Z]+) (0x[0-9A-Fa-f]+).*" "\\1;\\2" _parts "${_definition}")
    list(GET _parts 0 _name)
    list(GET _parts 1 ${_name})
endforeach()
if(NOT CKVERSION OR NOT DEVVERSION)
    message(FATAL_ERROR "Ballanced SDK must declare CKVERSION and DEVVERSION")
endif()
file(WRITE "${PROJECT_BINARY_DIR}/BallancedRuntime.txt" "BallancedSDK\n${CKVERSION}\n${DEVVERSION}\n")
install(FILES "${PROJECT_BINARY_DIR}/BallancedRuntime.txt" DESTINATION Bin COMPONENT Runtime)

# All targets retain their component's install ownership. Stage Runtime only,
# after building its modules, for both the editor and the real-runtime tests.
function(virtoolsdev_collect_targets directory output)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        virtoolsdev_collect_targets("${_child}" _child_targets)
        list(APPEND _targets ${_child_targets})
    endforeach()
    set(${output} ${_targets} PARENT_SCOPE)
endfunction()
set(_runtime_targets)
foreach(_component VxMath CK2 RenderEngine Managers Plugins BuildingBlocks)
    virtoolsdev_collect_targets("${VIRTOOLS_SDK_PATH}/Source/${_component}" _component_targets)
    foreach(_target IN LISTS _component_targets)
        get_target_property(_type ${_target} TYPE)
        if(_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
            list(APPEND _runtime_targets ${_target})
            if(UNIX)
                set_property(TARGET ${_target} APPEND PROPERTY INSTALL_RPATH "$ORIGIN/../Bin")
                if(APPLE)
                    set_property(TARGET ${_target} PROPERTY INSTALL_RPATH "@loader_path/../Bin")
                endif()
            endif()
        endif()
    endforeach()
endforeach()
add_custom_target(VirtoolsDevRuntime ALL
    COMMAND ${CMAKE_COMMAND} --install "${PROJECT_BINARY_DIR}" --prefix "${PROJECT_BINARY_DIR}/runtime" --component Runtime --config $<CONFIG>
    DEPENDS ${_runtime_targets}
    VERBATIM)
