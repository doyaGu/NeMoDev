# The SDK installs fonts in Bin/data. The application's installed layout keeps
# all read-only data next to Bin. Run before installing current application data
# so that a reinstall cannot replace it with an older copy from Bin/data.
set(_legacy_data "${CMAKE_INSTALL_PREFIX}/Bin/data")
set(_data "${CMAKE_INSTALL_PREFIX}/data")

function(_nemodev_move_data source destination)
    file(MAKE_DIRECTORY "${destination}")
    file(GLOB _entries LIST_DIRECTORIES true "${source}/*" "${source}/.*")
    foreach(_entry IN LISTS _entries)
        get_filename_component(_name "${_entry}" NAME)
        if(_name STREQUAL "." OR _name STREQUAL "..")
            continue()
        endif()
        set(_target "${destination}/${_name}")
        if(IS_DIRECTORY "${_entry}" AND NOT IS_SYMLINK "${_entry}" AND EXISTS "${_target}")
            if(NOT IS_DIRECTORY "${_target}" OR IS_SYMLINK "${_target}")
                message(FATAL_ERROR "Cannot merge application data into ${_target}")
            endif()
            _nemodev_move_data("${_entry}" "${_target}")
        else()
            file(RENAME "${_entry}" "${_target}")
        endif()
    endforeach()
    # All entries have been moved. Neither source nor destination is traversed
    # through a symlink, and both directories were checked against the prefix.
    file(REMOVE_RECURSE "${source}")
endfunction()
if(IS_DIRECTORY "${_legacy_data}")
    file(REAL_PATH "${CMAKE_INSTALL_PREFIX}" _prefix)
    file(REAL_PATH "${_legacy_data}" _source)
    cmake_path(IS_PREFIX _prefix "${_source}" NORMALIZE _source_inside)
    if(NOT _source_inside OR IS_SYMLINK "${_legacy_data}")
        message(FATAL_ERROR "Legacy application data must stay inside the installation: ${_legacy_data}")
    endif()
    if(EXISTS "${_data}")
        file(REAL_PATH "${_data}" _destination)
        cmake_path(IS_PREFIX _prefix "${_destination}" NORMALIZE _destination_inside)
        cmake_path(IS_PREFIX _source "${_destination}" NORMALIZE _destination_in_source)
        cmake_path(IS_PREFIX _destination "${_source}" NORMALIZE _source_in_destination)
        if(NOT _destination_inside OR _destination_in_source OR _source_in_destination)
            message(FATAL_ERROR "Application data directories must not overlap or leave the installation")
        endif()
        _nemodev_move_data("${_legacy_data}" "${_data}")
    else()
        file(RENAME "${_legacy_data}" "${_data}")
    endif()
endif()
