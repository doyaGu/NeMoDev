if (NOT SOURCE_DIRECTORY OR NOT RUNTIME_DIRECTORY)
    message(FATAL_ERROR "SOURCE_DIRECTORY and RUNTIME_DIRECTORY are required")
endif ()

function(check_notice source runtime)
    if (NOT EXISTS "${RUNTIME_DIRECTORY}/${runtime}")
        message(FATAL_ERROR "Missing runtime notice: ${runtime}")
    endif ()
    file(SHA256 "${SOURCE_DIRECTORY}/${source}" _expected)
    file(SHA256 "${RUNTIME_DIRECTORY}/${runtime}" _actual)
    if (NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Runtime notice differs from its source: ${runtime}")
    endif ()
endfunction()

check_notice(LICENSE LICENSE)
check_notice(THIRD_PARTY_NOTICES.md THIRD_PARTY_NOTICES.md)
file(GLOB_RECURSE _notices RELATIVE "${SOURCE_DIRECTORY}"
        "${SOURCE_DIRECTORY}/licenses/*.txt" "${SOURCE_DIRECTORY}/licenses/*.json")
foreach (_notice IN LISTS _notices)
    check_notice("${_notice}" "${_notice}")
endforeach ()
check_notice(core/interface/origin.json licenses/VirtoolsScriptDeobfuscation-origin.json)
foreach (_font_notice OFL.txt OFL-NotoSans.txt sources.json)
    check_notice("resources/fonts/${_font_notice}" "licenses/fonts/${_font_notice}")
endforeach ()

# A changed license copy must also update its recorded source checksum.
foreach (_manifest origin.json html-origin.json)
    file(READ "${SOURCE_DIRECTORY}/licenses/${_manifest}" _origins)
    string(JSON _count LENGTH "${_origins}" files)
    math(EXPR _last "${_count} - 1")
    foreach (_index RANGE ${_last})
        string(JSON _file GET "${_origins}" files ${_index} file)
        string(JSON _expected GET "${_origins}" files ${_index} sha256)
        file(READ "${SOURCE_DIRECTORY}/licenses/${_file}" _text)
        string(REPLACE "\r\n" "\n" _text "${_text}")
        string(SHA256 _actual "${_text}")
        if (NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "License source checksum mismatch: ${_file}")
        endif ()
    endforeach ()
endforeach ()
message(STATUS "Runtime license texts, attribution and source manifests match")
