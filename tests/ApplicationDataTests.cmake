cmake_minimum_required(VERSION 3.25)
if(NOT SOURCE_DIRECTORY OR NOT BINARY_DIRECTORY)
    message(FATAL_ERROR "SOURCE_DIRECTORY and BINARY_DIRECTORY are required")
endif()
set(CMAKE_INSTALL_PREFIX "${BINARY_DIRECTORY}/application data installation")
file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}/Bin/data/fonts")
file(WRITE "${CMAKE_INSTALL_PREFIX}/Bin/data/fonts/font.ttf" "font bytes")
file(WRITE "${CMAKE_INSTALL_PREFIX}/Bin/data/interface.nmo" "interface bytes")
include("${SOURCE_DIRECTORY}/cmake/InstallApplicationData.cmake")
if(EXISTS "${CMAKE_INSTALL_PREFIX}/Bin/data")
    message(FATAL_ERROR "The installed data directory remains in Bin")
endif()
file(READ "${CMAKE_INSTALL_PREFIX}/data/fonts/font.ttf" _font)
file(READ "${CMAKE_INSTALL_PREFIX}/data/interface.nmo" _interface)
if(NOT _font STREQUAL "font bytes" OR NOT _interface STREQUAL "interface bytes")
    message(FATAL_ERROR "Moving data changed its contents")
endif()

# Runtime can be installed again before Application. Merge its fonts without
# removing application data or any additional resource files from either tree.
file(WRITE "${CMAKE_INSTALL_PREFIX}/data/keep.txt" "existing resource")
file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}/Bin/data/fonts")
file(WRITE "${CMAKE_INSTALL_PREFIX}/Bin/data/fonts/font.ttf" "updated font bytes")
file(WRITE "${CMAKE_INSTALL_PREFIX}/Bin/data/extra.txt" "additional resource")
file(WRITE "${CMAKE_INSTALL_PREFIX}/Bin/data/.resource" "hidden resource")
include("${SOURCE_DIRECTORY}/cmake/InstallApplicationData.cmake")
file(READ "${CMAKE_INSTALL_PREFIX}/data/fonts/font.ttf" _font)
file(READ "${CMAKE_INSTALL_PREFIX}/data/keep.txt" _keep)
file(READ "${CMAKE_INSTALL_PREFIX}/data/extra.txt" _extra)
file(READ "${CMAKE_INSTALL_PREFIX}/data/.resource" _hidden)
if(EXISTS "${CMAKE_INSTALL_PREFIX}/Bin/data" OR NOT _font STREQUAL "updated font bytes"
        OR NOT _keep STREQUAL "existing resource" OR NOT _extra STREQUAL "additional resource"
        OR NOT _hidden STREQUAL "hidden resource")
    message(FATAL_ERROR "Reinstalling data did not preserve the merged resources")
endif()
include("${SOURCE_DIRECTORY}/cmake/InstallApplicationData.cmake")
message(STATUS "Root data installation, relocation and reinstall passed")
