VIRTOOLSDEV_CASE(BatchCommands)
VIRTOOLSDEV_CASE(ObjectPropertyUndo)
VIRTOOLSDEV_CASE(ObjectEditFailures)
VIRTOOLSDEV_CASE(ObjectEditCancellation)
VIRTOOLSDEV_CASE(SaveFailures)
VIRTOOLSDEV_CASE(SaveCallbacks)
VIRTOOLSDEV_CASE(InitialConditionsScenes)
VIRTOOLSDEV_CASE(CkArrays)
VIRTOOLSDEV_CASE(SetupActions)
VIRTOOLSDEV_CASE(DeterministicEdits)
VIRTOOLSDEV_CASE(SyntheticFuzz)
VIRTOOLSDEV_CASE(ThisParameter)
VIRTOOLSDEV_CASE(UnreadableChunks)
