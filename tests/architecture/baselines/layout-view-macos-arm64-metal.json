  "resolved_during_validation": [
    {
      "finding": "停靠视图恢复时同时设置坐标和停靠节点，ImGui 将其解除停靠，遮挡其他窗口并改变键盘焦点。",
      "fix": "只给浮动窗口恢复坐标和尺寸，停靠窗口保留节点；外部 Layout 往返断言停靠节点，Hierarchy F2 顺序回归重新通过。"
    },
    {
      "finding": "Layout 参数确认改为绘制回调后不能立即加入原生 Edit；过早释放工作参数会使帧末确认失效。",
      "fix": "复用 ApplyEdit 和既有帧末队列，在完成前保留参数副本；关闭时在作用域有效期间直接取消。"
    },
    {
      "finding": "Layout 的参数弹窗在主窗口结束后绘制，按主窗口父子关系清理会遗漏它。",
      "fix": "工作区记录每次绘制的顶层辅助窗口，统一结束所属输入和弹窗；补测待确认放置中关闭。"
    },
    {
      "finding": "排队分支满载时，原生参数确认曾可能带着参数校验成功状态返回而未提交。",
      "fix": "队列满时明确返回拒绝，回归验证不产生操作、原生 Edit 仍可取消。"
    }
  ],
  "remaining": [
    "阶段五其他迁移与跨视图、锁选择的剩余组合检查继续保留在覆盖清单。",
    "完成阶段保持三；正式性能验收继续暂缓，原定门槛不变。"
  ],
