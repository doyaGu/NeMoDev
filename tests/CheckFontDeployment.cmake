file(READ "${FONT_MANIFEST}" _sources)
string(JSON _count LENGTH "${_sources}")
math(EXPR _last "${_count} - 1")
foreach (_i RANGE ${_last})
    string(JSON _name MEMBER "${_sources}" ${_i})
    string(JSON _expected GET "${_sources}" "${_name}" sha256)
    set(_file "${FONT_DIRECTORY}/${_name}")
    if (NOT EXISTS "${_file}")
        message(FATAL_ERROR "Missing runtime font or license: ${_name}")
    endif ()
    file(SHA256 "${_file}" _actual)
    if (NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Runtime font checksum mismatch: ${_name}")
    endif ()
endforeach ()
