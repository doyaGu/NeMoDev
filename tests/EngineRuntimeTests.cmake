if(NOT RUNTIME_FILES)
    message(FATAL_ERROR "The configured engine has no runtime files")
endif()
foreach(file IN LISTS RUNTIME_FILES)
    if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}")
        message(FATAL_ERROR "Missing configured NeMo2 runtime file: ${file}")
    endif()
endforeach()
message(STATUS "Every configured NeMo2 module and render configuration is staged")
